<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sbarm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import sbarm urdf file -->
    <xacro:include filename="$(find sbarm_description)/urdf/sbarm_description.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="sbarm.ros2_control.xacro" />


    <xacro:sbarm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
