<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action ID="ActionCommandSuckerSystem" command="suck"/>
            <Delay delay_msec="500">
                <Action ID="ActionCommandSuckerSystem" command="blow"/>
            </Delay>
            <Delay delay_msec="500">
                <Action ID="ActionCommandSuckerSystem" command="off"/>
            </Delay>
            <Delay delay_msec="500">
                <Action ID="ActionCommandStorageSystem" left="on" right="nope"/>
            </Delay>
            <Delay delay_msec="250">
                <Action ID="ActionCommandStorageSystem" left="nope" right="on"/>
            </Delay>
            <Delay delay_msec="250">
                <Action ID="ActionCommandStorageSystem" left="off" right="off"/>
            </Delay>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="ActionCommandArmEndEffectorPose">
            <input_port name="srdf_pose_name" type="std::string"/>
            <output_port name="trajectory" type="std::string"/>
        </Action>
        <Action ID="ActionCommandArmJointPosition">
            <input_port name="srdf_pose_name" type="std::string"/>
            <output_port name="trajectory" type="std::string"/>
        </Action>
        <Action ID="ActionCommandArmJointTrajectory">
            <input_port name="playback_speed" type="double"/>
            <input_port name="trajectory" type="trajectory_msgs::msg::JointTrajectory_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Action>
        <Action ID="ActionCommandChassis">
            <input_port name="srdf_pose_name" type="std::string"/>
            <output_port name="trajectory" type="std::string"/>
        </Action>
        <Action ID="ActionCommandStorageSystem">
            <input_port name="left" type="std::string"/>
            <input_port name="right" type="std::string"/>
        </Action>
        <Action ID="ActionCommandSuckerSystem">
            <input_port name="command" type="std::string"/>
        </Action>
        <Action ID="ActionPlanToEndEffectorPose">
            <input_port name="srdf_pose_name" type="std::string"/>
            <output_port name="trajectory" type="trajectory_msgs::msg::JointTrajectory_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Action>
        <Action ID="ActionPlanToJointPosition">
            <input_port name="joint_positions" type="std::vector&lt;double, std::allocator&lt;double&gt; &gt;"/>
            <output_port name="trajectory" type="trajectory_msgs::msg::JointTrajectory_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Action>
        <Action ID="ActionPlanToLiftEndEffector">
            <input_port name="lift_distance" type="double"/>
            <input_port name="max_linear_speed" type="double"/>
            <output_port name="trajectory" type="trajectory_msgs::msg::JointTrajectory_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Action>
        <Action ID="ActionSetNavigationTarget"/>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
