<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <KeepRunningUntilFailure>
            <Sequence>
                <Action ID="ActionArmPumpOn"/>
                <Delay delay_msec="1000">
                    <Action ID="ActionArmPumpOff"/>
                </Delay>
            </Sequence>
        </KeepRunningUntilFailure>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="ActionArmBack"/>
        <Action ID="ActionArmExtendAboveSilver"/>
        <Action ID="ActionArmPumpOff"/>
        <Action ID="ActionArmPumpOn"/>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
