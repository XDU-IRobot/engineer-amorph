<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amorph">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import amorph urdf file -->
    <xacro:include filename="$(find amorph_arm_v2_description)/urdf/amorph.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="amorph.ros2_control.xacro" />


    <xacro:amorph_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
