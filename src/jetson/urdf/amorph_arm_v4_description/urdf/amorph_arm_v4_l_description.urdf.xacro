    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0.02" effort="1" velocity="1" />
    <mimic joint="gripper_l_l" multiplier="-1" offset="0" />
  </joint>

  <joint name="limit_l" type="revolute">
