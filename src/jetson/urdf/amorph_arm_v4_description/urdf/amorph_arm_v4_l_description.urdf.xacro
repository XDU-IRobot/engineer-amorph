    <child link="l2_l" />
    <origin xyz="0.0175 0 0.07775" rpy="1.5708 0 1.5708" />
    <axis xyz="0 0 1" />
    <limit lower="1.397853" upper="2.9407241" effort="1" velocity="1" />
