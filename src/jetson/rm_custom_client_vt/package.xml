<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rm_custom_client_vt</name>
  <version>0.0.0</version>
  <description>UDP H.265 video transport receiver for RoboMaster custom client. Receives raw H.265 stream from UDP port 3334, decodes via GStreamer, and publishes as ROS 2 Image/CameraInfo topics for RViz2 Camera display.</description>
  <maintainer email="messenger@lunariio.work">lunarifish</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>std_msgs</depend>
  <depend>ros2launch</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
