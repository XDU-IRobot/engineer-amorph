{
  "C_Cpp.intelliSenseEngine": "disabled",
  "python.autoComplete.extraPaths": [
    "/opt/ros/humble/lib/python3.10/site-packages"
  ],
  "python.analysis.extraPaths": ["/opt/ros/humble/lib/python3.10/site-packages"], // change the distro name and python version accordingly
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "VsCodeTaskButtons.showCounter": false,
  "VsCodeTaskButtons.tasks": [
    {
      "label": "$(notebook-move-down)",
      "task": "build",
      "tooltip": "🛠️ Colcon build"
    },
    {
      "label": "$(notebook-delete-cell)",
      "task": "clean",
      "tooltip": "🧹 Clean"
    }
  ],
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash",
      "args": ["-c", "source ${workspaceFolder}/install/setup.bash;exec bash"]
    }
  },
  "clangd.detectExtensionConflicts": true,
  "clangd.path": "clangd",
  "clangd.fallbackFlags": [],
  "clangd.arguments": [
    "--background-index",
    "--compile-commands-dir=build",
    "-j=12",
    "--all-scopes-completion",
    "--completion-style=detailed",
    "--pch-storage=memory", // pch = precompiled header
    "--cross-file-rename",
    "--fallback-style=Google", // clang-format style to apply by default when no .clang-format file is found
    "--pretty",
    "--clang-tidy",
    "--query-driver=gcc"
  ],
  "ros.distro": "humble",
  "cmake.sourceDirectory": "/home/lunarifish/engineer-amorph/build_3rdparty/easy_handeye2_msgs/easy_handeye2_msgs__py",
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "ROS2.distro": "jazzy"
}
